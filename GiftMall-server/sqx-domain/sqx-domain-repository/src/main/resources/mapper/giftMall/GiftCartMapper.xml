<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.domain.repository.mapper.giftMall.GiftCartMapper">
    <select id="sum" resultType="java.lang.Long">
        SELECT
            ifnull(sum(number), 0)
        FROM
            `gift_cart`
        WHERE
            user_id = #{userId}
    </select>
</mapper>
